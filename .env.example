# Copy this file to .env and fill it in. .env is git-ignored. Never commit it, never paste it in chat.

# Free Gemini API key. Create a NEW key in its own project at aistudio.google.com/apikey
# (do not reuse another project's key: separate quota, separate revoke)
GEMINI_API_KEY=
# Models tried in order; the first that answers is used
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
# Safety cap on model calls per day (the bot stops asking the model after this)
MODEL_DAILY_CALL_CAP=150

# Telegram (the chat channel). In Telegram, message @BotFather, send /newbot, and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram id (message @userinfobot to see it). The bot talks to this chat only.
TELEGRAM_OWNER_CHAT_ID=
# At most this many messages a day that the bot starts on its own
DAILY_PROACTIVE_CAP=8

# Public usernames, used only to read public stats for reminders
LEETCODE_USER=
GITHUB_USER=

# Folder with your private files (plan, tracker, facts). Stays out of this repo.
CA_PRIVATE_DIR=../notebooks/09-career-autopilot

# Where the SQLite file lives (outside OneDrive is better: it changes often)
CA_DB_PATH=data/ca.sqlite
TIMEZONE=Asia/Kolkata
# Quiet hours: no proactive messages between these hours (24h clock)
QUIET_START=23
QUIET_END=7
