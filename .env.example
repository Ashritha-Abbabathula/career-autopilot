# Copy this file to .env and fill it in. .env is git-ignored. Never commit it, never paste it in chat.

# Free Gemini API key (the same kind you already use in PingFarm)
GEMINI_API_KEY=
# Models tried in order; the first that answers is used
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
# Safety cap on model calls per day (the bot stops asking the model after this)
MODEL_DAILY_CALL_CAP=150

# WhatsApp (Meta Cloud API). Filled in from slice CA-7 on.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The only phone number the bot will talk to, digits with country code, e.g. 91XXXXXXXXXX
OWNER_WHATSAPP=

# Where the SQLite file lives (outside OneDrive is better: it changes often)
CA_DB_PATH=data/ca.sqlite
TIMEZONE=Asia/Kolkata
# Quiet hours: no proactive messages between these hours (24h clock)
QUIET_START=23
QUIET_END=7
